<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色磨砂 -->
    <LinearGradientBrush x:Key="PanelBg" StartPoint="0,0" EndPoint="0.45,1">
        <GradientStop Color="#9AF8FAFE" Offset="0" />
        <GradientStop Color="#8AEEF1F8" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Stroke"        Color="#24191A20" />
    <SolidColorBrush x:Key="StrokeSoft"    Color="#14191A20" />
    <SolidColorBrush x:Key="TextStrong"    Color="#14151A" />
    <SolidColorBrush x:Key="TextDim"       Color="#30323A" />
    <SolidColorBrush x:Key="TextFaint"     Color="#7B7D8A" />
    <SolidColorBrush x:Key="PillHover"     Color="#0E000000" />
    <SolidColorBrush x:Key="PillActive"    Color="#18000000" />
    <SolidColorBrush x:Key="ItemHover"     Color="#10000000" />
    <SolidColorBrush x:Key="Accent"        Color="#3A63F0" />
    <SolidColorBrush x:Key="ZoneBg" Color="#09000000" />

    <LinearGradientBrush x:Key="ZoneBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#48000000" Offset="0" />
        <GradientStop Color="#1E000000" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ItemSelected"  Color="#333A63F0" />
    <SolidColorBrush x:Key="AccentSoft"    Color="#403A63F0" />
    <SolidColorBrush x:Key="Divider"       Color="#12000000" />
    <SolidColorBrush x:Key="PanelTint"     Color="#07000000" />
    <SolidColorBrush x:Key="MenuBg"        Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="MenuHover"     Color="#14000000" />
    <SolidColorBrush x:Key="ScrollThumb"   Color="#33000000" />

    <Color x:Key="BackdropTint">#B3F4F5F9</Color>

</ResourceDictionary>
