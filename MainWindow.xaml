<Window x:Class="DeskTidy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sh="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DeskTidy"
        Width="652" Height="90"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI, Microsoft YaHei"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale">

    <Window.Resources>
        <Style x:Key="FileMenuStyle" TargetType="ContextMenu"
               BasedOn="{StaticResource {x:Type ContextMenu}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource MenuBg}"
                                CornerRadius="10"
                                BorderBrush="{DynamicResource Stroke}"
                                BorderThickness="1"
                                Padding="4"
                                Margin="8"
                                MinWidth="200"
                                TextOptions.TextRenderingMode="ClearType"
                                TextOptions.TextFormattingMode="Ideal">
                            <StackPanel>
                                <Border Padding="4,3,4,5" Margin="0,0,0,4"
                                        BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource Divider}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource MenuQuickButton}" Tag="cut" Click="MenuQuick_Click" ToolTip="剪切">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8C6;" FontSize="15" />
                                        </Button>
                                        <Button Style="{StaticResource MenuQuickButton}" Tag="copy" Click="MenuQuick_Click" ToolTip="复制">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="15" />
                                        </Button>
                                        <Button Style="{StaticResource MenuQuickButton}" Tag="rename" Click="MenuQuick_Click" ToolTip="重命名">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8AC;" FontSize="15" />
                                        </Button>
                                        <Button Style="{StaticResource MenuQuickButton}" Tag="share" Click="MenuQuick_Click" ToolTip="共享">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72D;" FontSize="15" />
                                        </Button>
                                        <Button Style="{StaticResource MenuQuickButton}" Tag="properties" Click="MenuQuick_Click" ToolTip="属性">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE713;" FontSize="15" />
                                        </Button>
                                        <Button Style="{StaticResource MenuQuickButton}" Tag="delete" Click="MenuQuick_Click" ToolTip="删除">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE74D;" FontSize="15" />
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <StackPanel IsItemsHost="True" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 投影（单独一层，避免 Effect 影响正文清晰度）
             必须与主体同心，否则偏移的那一侧会把圆角外区域填灰，看起来就不圆了 -->
        <Border Margin="17,18,17,19" CornerRadius="15" Background="#4D000000"
                IsHitTestVisible="False">
            <Border.Effect>
                <BlurEffect Radius="16" KernelType="Gaussian" />
            </Border.Effect>
        </Border>

        <!-- 主体玻璃壳 -->
        <Border x:Name="Shell"
                Margin="16"
                CornerRadius="15"
                BorderThickness="1"
                BorderBrush="{DynamicResource Stroke}"
                Background="Transparent"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 磨砂底图（模糊壁纸，随窗口位置裁剪） -->
                <Border x:Name="FrostLayer" Grid.Row="0" Grid.RowSpan="2"
                        CornerRadius="15" Background="Transparent"
                        IsHitTestVisible="False" />

                <!-- 色调层：叠在磨砂之上，决定整体明暗 -->
                <Border Grid.Row="0" Grid.RowSpan="2"
                        CornerRadius="15"
                        Background="{DynamicResource PanelBg}"
                        IsHitTestVisible="False" />

                <!-- 顶部玻璃反光 -->
                <Border Grid.Row="0" Grid.RowSpan="2"
                        Height="34" VerticalAlignment="Top"
                        IsHitTestVisible="False"
                        CornerRadius="15,15,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1EFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- ================= 顶栏 ================= -->
                <Grid x:Name="TopBar" Grid.Row="0" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 拖动手柄 -->
                    <Border Grid.Column="0" Width="28" Background="Transparent" Cursor="SizeAll">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <Ellipse Width="2.6" Height="2.6" Fill="{DynamicResource TextFaint}" />
                            <Ellipse Width="2.6" Height="2.6" Fill="{DynamicResource TextFaint}" Margin="0,3" />
                            <Ellipse Width="2.6" Height="2.6" Fill="{DynamicResource TextFaint}" />
                        </StackPanel>
                    </Border>

                    <!-- 分区胶囊条 -->
                    <ScrollViewer x:Name="ZonesScroll"
                                  Grid.Column="1"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Center"
                                  Padding="0">
                        <ItemsControl x:Name="ZonesHost">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,14,0">
                                        <!-- 外层边框：把手柄和文字整个包住 -->
                                        <!-- 外层边框：文字整体上下居中，三个点叠在顶部 -->
                                        <Border x:Name="Frame"
                                                Height="{DynamicResource ZoneFrameHeight}"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource ZoneBorder}"
                                                Background="{DynamicResource ZoneBg}"
                                                Padding="16,0"
                                                Cursor="Hand"
                                                AllowDrop="True"
                                                DragOver="Zone_DragOver"
                                                Drop="Zone_Drop"
                                                MouseLeftButtonDown="Zone_MouseLeftButtonDown"
                                                MouseRightButtonDown="Zone_MouseRightButtonDown">
                                            <Grid>
                                                <Border x:Name="HoverLayer" CornerRadius="8"
                                                        Background="Transparent" IsHitTestVisible="False">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Frame}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource PillHover}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <TextBlock x:Name="Label"
                                                           Text="{Binding Name}"
                                                           FontSize="{DynamicResource ZoneFontSize}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,4,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextDim}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="{DynamicResource ZoneLabelMaxWidth}" />

                                                <TextBox x:Name="EditBox"
                                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="Collapsed"
                                                         Width="{DynamicResource ZoneLabelMaxWidth}"
                                                         FontSize="{DynamicResource ZoneFontSize}"
                                                         FontWeight="SemiBold"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Padding="0"
                                                         Foreground="{DynamicResource TextStrong}"
                                                         CaretBrush="{DynamicResource TextStrong}"
                                                         SelectionBrush="{DynamicResource Accent}"
                                                         FocusVisualStyle="{x:Null}"
                                                         Margin="0,4,0,0"
                                                         VerticalAlignment="Center"
                                                         KeyDown="ZoneEdit_KeyDown"
                                                         LostFocus="ZoneEdit_LostFocus" />

                                                <!-- 三点手柄：叠在顶部，不占文字布局 -->
                                                <Border Height="10" VerticalAlignment="Top"
                                                        Margin="-16,0,-16,0"
                                                        Background="Transparent"
                                                        Cursor="SizeWE"
                                                        MouseLeftButtonDown="ZoneHandle_MouseLeftButtonDown"
                                                        MouseMove="ZoneHandle_MouseMove"
                                                        MouseLeftButtonUp="ZoneHandle_MouseLeftButtonUp">
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Opacity="0.55">
                                                        <Ellipse Width="1.8" Height="1.8" Margin="0,0,2,0"
                                                                 Fill="{DynamicResource TextDim}" />
                                                        <Ellipse Width="1.8" Height="1.8" Margin="0,0,2,0"
                                                                 Fill="{DynamicResource TextDim}" />
                                                        <Ellipse Width="1.8" Height="1.8"
                                                                 Fill="{DynamicResource TextDim}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource PillActive}" />
                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextStrong}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="EditBox" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 右侧操作 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="4,0,9,0">
                        <Button x:Name="AddZoneBtn" Style="{StaticResource IconButton}"
                                Click="AddZone_Click" ToolTip="新建分区">
                            <Path Data="M0,5 H10 M5,0 V10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Button>
                        <Button x:Name="MenuBtn" Style="{StaticResource IconButton}"
                                Click="Menu_Click" ToolTip="更多设置">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="3" Height="3" Margin="0,0,3.5,0"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                <Ellipse Width="3" Height="3" Margin="0,0,3.5,0"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                <Ellipse Width="3" Height="3"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ================= 展开面板 ================= -->
                <Border x:Name="PanelHost"
                        Grid.Row="1"
                        CornerRadius="0,0,14,14"
                        Background="{DynamicResource PanelTint}"
                        ClipToBounds="True"
                        AllowDrop="True"
                        DragOver="Panel_DragOver"
                        DragLeave="Panel_DragLeave"
                        Drop="Panel_Drop">
                    <Grid>
                        <Border Height="1" Margin="10,0" VerticalAlignment="Top"
                                Background="{DynamicResource Divider}" />

                        <ScrollViewer x:Name="PanelScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="12,11,12,12"
                                      Margin="0,1,0,0">
                            <ItemsControl x:Name="ItemsHost">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" ItemWidth="92" ItemHeight="98" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent"
                                              AllowDrop="True"
                                              ToolTip="{Binding DisplayName}"
                                              MouseLeftButtonDown="Item_MouseLeftButtonDown"
                                              MouseLeftButtonUp="Item_MouseLeftButtonUp"
                                              MouseMove="Item_MouseMove"
                                              DragOver="Item_DragOver"
                                              DragLeave="Item_DragLeave"
                                              Drop="Item_Drop"
                                              MouseRightButtonUp="Item_MouseRightButtonUp">
                                            <Grid.ContextMenu>
                                                <ContextMenu Style="{StaticResource FileMenuStyle}">
                                                    <MenuItem Header="打开" Click="ItemMenu_Open">
                                                        <MenuItem.Icon>
                                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8E5;" FontSize="14" Foreground="{DynamicResource TextDim}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="打开方式…" Click="ItemMenu_OpenWith">
                                                        <MenuItem.Icon>
                                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7AC;" FontSize="14" Foreground="{DynamicResource TextDim}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="复制" Click="ItemMenu_Copy">
                                                        <MenuItem.Icon>
                                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="14" Foreground="{DynamicResource TextDim}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="剪切" Click="ItemMenu_Cut">
                                                        <MenuItem.Icon>
                                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8C6;" FontSize="14" Foreground="{DynamicResource TextDim}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="创建快捷方式" Click="ItemMenu_CreateShortcut">
                                                        <MenuItem.Icon>
                                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE71B;" FontSize="14" Foreground="{DynamicResource TextDim}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="重命名（显示名）" Click="ItemMenu_Rename">
                                                        <MenuItem.Icon>
                                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8AC;" FontSize="14" Foreground="{DynamicResource TextDim}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="放回桌面" Click="ItemMenu_ToDesktop">
                                                        <MenuItem.Icon>
                                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8DE;" FontSize="14" Foreground="{DynamicResource TextDim}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="从这个分区移除" Click="ItemMenu_Remove">
                                                        <MenuItem.Icon>
                                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE738;" FontSize="14" Foreground="{DynamicResource TextDim}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="属性" Click="ItemMenu_Properties">
                                                        <MenuItem.Icon>
                                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE713;" FontSize="14" Foreground="{DynamicResource TextDim}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Grid.ContextMenu>

                                            <Border x:Name="Card" CornerRadius="10" Margin="4,2"
                                                    Background="Transparent">
                                              <Grid>
                                                <Border x:Name="SelLayer" CornerRadius="8"
                                                        Background="{DynamicResource ItemSelected}"
                                                        Visibility="Collapsed"
                                                        IsHitTestVisible="False" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <Grid Width="40" Height="40" HorizontalAlignment="Center">
                                                        <Image Source="{Binding Icon}"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                        <TextBlock x:Name="InitialText"
                                                                   Text="{Binding Initial}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextFaint}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="Collapsed" />
                                                    </Grid>
                                                    <Grid Margin="2,8,2,0" Height="16">
                                                        <TextBlock x:Name="NameText"
                                                                   Text="{Binding DisplayName}"
                                                                   FontSize="11"
                                                                   TextAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextDim}" />
                                                        <TextBox x:Name="NameEdit"
                                                                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                                 Visibility="Collapsed"
                                                                 FontSize="11"
                                                                 TextAlignment="Center"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 Padding="0"
                                                                 Foreground="{DynamicResource TextStrong}"
                                                                 CaretBrush="{DynamicResource TextStrong}"
                                                                 SelectionBrush="{DynamicResource Accent}"
                                                                 FocusVisualStyle="{x:Null}"
                                                                 VerticalAlignment="Center"
                                                                 KeyDown="ItemNameEdit_KeyDown"
                                                                 LostFocus="ItemNameEdit_LostFocus" />
                                                    </Grid>
                                                </StackPanel>
                                              </Grid>
                                            </Border>
                                        </Grid>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                <Setter TargetName="InitialText" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                                                <Setter TargetName="Card" Property="Opacity" Value="0.3" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter TargetName="NameText" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="NameEdit" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="SelLayer" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource ItemHover}" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 空分区提示 -->
                        <TextBlock x:Name="EmptyHint"
                                   Text="这个分区还空着 · 把桌面图标拖进来"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFaint}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False" />

                        <!-- 拖拽插入指示 + 框选层 -->
                        <Canvas x:Name="DropLayer" IsHitTestVisible="False">
                            <Border x:Name="SelectionBox"
                                    Visibility="Collapsed"
                                    Background="#336C8CFF"
                                    BorderBrush="{DynamicResource Accent}"
                                    BorderThickness="1"
                                    CornerRadius="4" />
                            <Border x:Name="DropLine"
                                    Width="2" Height="60" CornerRadius="1"
                                    Background="{DynamicResource Accent}"
                                    Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0"
                                                      Color="#6C8CFF" Opacity="0.85" />
                                </Border.Effect>
                            </Border>
                        </Canvas>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <!-- 设置菜单：用 Popup 自己管开关，鼠标移出才收起 -->
        <Popup x:Name="SettingsPopup"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=MenuBtn}"
               HorizontalOffset="0"
               VerticalOffset="4">
            <Border x:Name="SettingsPanel"
                    Background="{DynamicResource MenuBg}"
                    CornerRadius="10"
                    BorderBrush="{DynamicResource Stroke}"
                    BorderThickness="1"
                    Padding="4"
                    Margin="8"
                    MinWidth="215"
                    TextOptions.TextRenderingMode="ClearType"
                    TextOptions.TextFormattingMode="Ideal">
                <StackPanel x:Name="SettingsStack" />
            </Border>
        </Popup>
    </Grid>
</Window>
